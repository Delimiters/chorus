# Copy to .env.local and fill in from your Supabase project's
# Settings -> API. Both values are safe in a client bundle.
#
# EXPO_PUBLIC_ is required: Expo only inlines variables with that prefix into
# the app. A variable without it is undefined at runtime, silently.

# Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Settings -> API Keys -> publishable key (starts sb_publishable_).
# This does NOT bypass RLS and is designed to ship in the client.
# Never put the secret key (sb_secret_) here — it bypasses every policy.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
